# URL base da Fone Ninja Trading API (backend Laravel, pasta ../../backend).
# Sem valor real de segredo aqui - so aponta pra onde o backend esta rodando localmente.
#
# - Web / iOS Simulator: "localhost" enxerga a maquina host normalmente.
# - Android Emulator: "localhost" do emulador NAO e o mesmo da maquina host,
#   use 10.0.2.2 (ou descomente a linha abaixo).
# - Dispositivo fisico: use o IP da sua maquina na rede local (ex: 192.168.0.10).
EXPO_PUBLIC_API_URL=http://localhost:8000/api
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api
